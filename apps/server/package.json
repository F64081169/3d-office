{
  "name": "@office/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:sync": "prisma generate && prisma db push",
    "predev": "npm run db:sync",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "prestart": "npm run db:sync",
    "start": "tsx src/index.ts",
    "typecheck": "prisma generate && tsc --noEmit -p ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@office/agent-runtime": "0.1.0",
    "@office/llm-provider": "0.1.0",
    "@office/shared": "0.1.0",
    "@office/task-engine": "0.1.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
